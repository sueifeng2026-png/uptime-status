generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id          String    @id @default(cuid())
  name        String
  url         String
  description String?
  status      String    @default("unknown")
  lastChecked DateTime?
  responseMs  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  checks      Check[]
  incidents   Incident[]
}

model Check {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status     String
  statusCode Int?
  responseMs Int?
  error      String?
  createdAt  DateTime @default(now())
}

model Incident {
  id          String    @id @default(cuid())
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("investigating")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
}